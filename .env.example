# Required by Orca and tandemn-store.
TANDEMN_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/tandemn
TANDEMN_USER_ID=user_01J...

# Kubernetes targets. Leave TANDEMN_CLUSTER_CONTEXTS unset to use the current
# kubeconfig context for both workload types.
TANDEMN_K8S_NAMESPACE=dynamo-system
TANDEMN_BATCH_K8S_NAMESPACE=tandemn-system
# TANDEMN_CLUSTER_CONTEXTS={"aws:us-east-1":"eks-context","gcp:us-central1":"gke-context"}

# Batch integration.
TANDEMN_CHUNK_MANAGER_TARGET=127.0.0.1:9090
# TANDEMN_BATCH_WORKER_SECRET=tandemn-batch-worker
# TANDEMN_BATCH_AWS_REGION=us-east-1

# Online worker and router integration.
# TANDEMN_ONLINE_WORKER_SECRET=tandemn-online-worker
# TANDEMN_ROUTER_BINARY=/usr/local/bin/tandemn-router
# TANDEMN_ROUTER_CONFIG_DIR=/var/lib/tandemn/router
# TANDEMN_ROUTER_TELEMETRY_TOKEN=replace-me

# GPU metrics collector.
TANDEMN_PROMETHEUS_URL=http://localhost:9090
# TANDEMN_KUBE_CONTEXT=eks-context
# TANDEMN_ROUTER_URL_TEMPLATE=https://routers.example.com/{job_id}
